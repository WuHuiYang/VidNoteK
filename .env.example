# NoteKing Environment Configuration
# Copy this file to .env and fill in your values

# REQUIRED: LLM API Key (OpenAI / DeepSeek / etc.)
NOTEKING_LLM_API_KEY=sk-your-api-key-here

# OPTIONAL: Custom LLM provider (default: OpenAI)
# For DeepSeek:
# NOTEKING_LLM_BASE_URL=https://api.deepseek.com
# NOTEKING_LLM_MODEL=deepseek-chat

# For local Ollama:
# NOTEKING_LLM_BASE_URL=http://localhost:11434/v1
# NOTEKING_LLM_MODEL=qwen2.5

# OPTIONAL: Proxy for YouTube access from China
# NOTEKING_PROXY=socks5://127.0.0.1:7890

# OPTIONAL: Bilibili login cookie for HD content
# BILIBILI_SESSDATA=your_sessdata_here

# OPTIONAL: how to read a video that has no platform captions
# auto = captions, then burned-in OCR when text is detected, then speech-to-text
# ocr  = OCR burned-in subtitles only
# asr  = speech-to-text only
# cc   = platform captions only
# NOTEKING_SUBTITLE_MODE=auto

# OPTIONAL: browser binary for the no-login Douyin downloader
# NOTEKING_CHROME=/usr/bin/chromium
